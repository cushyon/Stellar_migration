# --- Server ---------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
# Comma-separated origins. Leave empty: the orchestrator calls this service server to server.
ALLOWED_ORIGINS=

# --- CPPI parameters ------------------------------------------------------
# PARAM: set with Wajih - do not default. The server does not start without them.
#   CPPI_FLOOR=0.6               the product promise, and floor_bps 6000 onchain
#   CPPI_MULTIPLIER=2            largest value with no floor breach over 2018-2026
#   CPPI_PROFIT_LOCKIN=0.19      lock-in step
#   CPPI_LIMIT_ORDER_SAFETY=1.02 safety factor on the limit order price
CPPI_FLOOR=
CPPI_MULTIPLIER=
CPPI_PROFIT_LOCKIN=
CPPI_LIMIT_ORDER_SAFETY=
