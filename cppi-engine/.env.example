# --- Server ---------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
# Comma-separated origins. Leave empty: the orchestrator calls this service server to server.
ALLOWED_ORIGINS=

# --- CPPI parameters ------------------------------------------------------
# PARAM: set with Wajih - do not default. The server does not start without them.
# Legacy Solana values, for reference only: floor 0.6, multiplier 8,
# profit lock-in 0.19, limit order safety 1.02.
CPPI_FLOOR=
CPPI_MULTIPLIER=
CPPI_PROFIT_LOCKIN=
CPPI_LIMIT_ORDER_SAFETY=
