# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://USER@localhost:5432/cushion_indexer"

# --- Stellar network ----------------------------------------------------
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Vault / assets (testnet deployment) --------------------------------
VAULT_CONTRACT_ID="CCIFWNFU3AJJOSECVZ6Z4SYSD6UXSIRXA72QTG724NP6WOG5RSJTP7SB"
BASE_ASSET_ID="CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC"
# Comma-separated; empty if the vault holds no risky legs yet.
RISKY_ASSET_IDS=""
# Reflector "External CEX & DEX" feed on testnet (USD base, symbol-keyed).
REFLECTOR_CONTRACT_ID="CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63"

# --- Indexer ------------------------------------------------------------
# Embedded poller cadence in seconds (set deliberately).
CRON_INTERVAL_SECONDS="30"
# Optional cold-start override (ledger number). Defaults to ~7d back.
START_LEDGER=""
PORT="8080"

# --- Keeper (proposes strategy trades; the vault checks them onchain) -------
# Off by default. Dry run stores the decision and sends nothing.
KEEPER_ENABLED="false"
KEEPER_DRY_RUN="true"
# Vault to drive. Defaults to VAULT_CONTRACT_ID.
KEEPER_VAULT_ID=""
KEEPER_RISKY_ASSET_ID=""
KEEPER_ROUTER_ID=""
STRATEGY_ENGINE_URL="http://localhost:8000"
# Operator key. Set it in the host environment only, never in the repo.
KEEPER_OPERATOR_PUBLIC=""
KEEPER_OPERATOR_SECRET=""
# Rebalance when the gap to the target reaches this size, in bps of NAV.
KEEPER_DRIFT_BPS="100"
# Room under the oracle price for min_amount_out, in bps.
KEEPER_SLIPPAGE_BPS="50"
# Alert when the base allocation is less than this above the floor (0.05 = 5 points).
KEEPER_CUSHION_ALERT_PCT="0.05"
