generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per onchain contract event. `id` is the event TOID — globally
/// sortable and unique — so re-ingestion is idempotent (dedup key).
model StellarEvent {
  id         String   @id
  ledger     Int
  ts         DateTime
  contractId String   @map("contract_id")
  type       String // deposit | withdraw | transfer | approve | burn | strategy | paused | unpaused
  topic      Json
  data       Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([contractId, ledger])
  @@index([contractId, type, ledger])
  @@map("stellar_event")
}

/// Periodic NAV/metrics snapshot for a vault — feeds TVL, allocation split,
/// and historical performance. nav/shares stored as exact NUMERIC (i128-safe).
model VaultSnapshot {
  id          Int      @id @default(autoincrement())
  contractId  String   @map("contract_id")
  ts          DateTime @default(now())
  ledger      Int
  nav         Decimal  @db.Decimal(40, 0)
  totalShares Decimal  @map("total_shares") @db.Decimal(40, 0)
  sharePrice  Float    @map("share_price")
  allocBase   Decimal  @map("alloc_base") @db.Decimal(40, 0)
  allocRisky  Decimal  @map("alloc_risky") @db.Decimal(40, 0)

  @@index([contractId, ts])
  @@map("vault_snapshot")
}

/// Current share holding per (vault, address), derived from share-moving events.
model UserPosition {
  vault     String
  address   String
  shares    Decimal  @db.Decimal(40, 0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([vault, address])
  @@map("user_position")
}

/// Single-row ingest cursor (last fully-ingested ledger) per contract.
model IngestState {
  contractId String @id @map("contract_id")
  lastLedger Int    @map("last_ledger")
}

/// USD price history per ticker, deduped to one row per hour (`bucket` =
/// floor(unix / 3600)). Accumulated from the Reflector oracle each cycle; the
/// historical window can be backfilled locally. Served to the dashboard chart.
model PriceSnapshot {
  symbol   String
  bucket   Int // unix hour bucket — dedup key
  ts       DateTime
  priceUsd Float    @map("price_usd")

  @@id([symbol, bucket])
  @@index([symbol, ts])
  @@map("price_snapshot")
}

/// Strategy state that the CPPI engine needs between runs, per vault. The
/// engine is stateless: the keeper stores the inception share price and the
/// high-water share price, and sends them on every call.
model StrategyState {
  vault              String   @id
  initialSharePrice  Float    @map("initial_share_price")
  maxSharePrice      Float    @map("max_share_price")
  lastLimitOrderPrice Float?  @map("last_limit_order_price")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("strategy_state")
}

/// One keeper decision. It records the proposal even when the keeper does not
/// send it (no drift, cooldown, dry run) and the vault answer when it does.
model StrategyRun {
  id         Int      @id @default(autoincrement())
  vault      String
  ts         DateTime @default(now())
  action     String // hold | buy_risky | sell_risky
  status     String // skipped | dry_run | submitted | rejected | unknown
  targetRiskyPct Float?  @map("target_risky_pct")
  actualRiskyPct Float?  @map("actual_risky_pct")
  amountIn   Decimal? @db.Decimal(40, 0) @map("amount_in")
  minOut     Decimal? @db.Decimal(40, 0) @map("min_out")
  nonce      Int?
  txHash     String?  @map("tx_hash")
  errorCode  Int?     @map("error_code")
  detail     String?

  @@index([vault, ts])
  @@map("strategy_run")
}

/// Risk picture of one cycle: how far the vault is from its floor, whether the
/// oracle answers, and whether the vault is paused.
model RiskSnapshot {
  id           Int      @id @default(autoincrement())
  vault        String
  ts           DateTime @default(now())
  nav          Decimal  @db.Decimal(40, 0)
  sharePrice   Float    @map("share_price")
  basePct      Float    @map("base_pct")
  floorPct     Float    @map("floor_pct")
  cushionPct   Float    @map("cushion_pct")
  oracleAgeSec Int?     @map("oracle_age_sec")
  oracleOk     Boolean  @map("oracle_ok")
  paused       Boolean
  alerts       String[] @default([])

  @@index([vault, ts])
  @@map("risk_snapshot")
}

/// One row per alert that is open or was open. The keeper sends a message when
/// an alert appears, a reminder at most every `ALERT_REPEAT_MINUTES`, and one
/// message when it clears. The row survives a restart, so a restart does not
/// send the same alert again.
model AlertState {
  id         String    @id // vault + key
  vault      String
  key        String
  message    String
  active     Boolean   @default(true)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSentAt DateTime? @map("last_sent_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([vault, active])
  @@map("alert_state")
}
